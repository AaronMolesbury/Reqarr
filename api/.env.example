# Copy to .env in this directory; the API loads it when run from api/.
# Existing process environment variables take precedence, including empty ones.
# Values are literal, optionally single/double quoted. Use full-line comments.
SEERR_URL=https://seerr.yourdomain.com
SEERR_API_KEY=replace-with-seerr-api-key
# Optional. Connect WireGuard on Windows to access your Radarr hostname.
RADARR_URL=
RADARR_API_KEY=
# Optional. Sonarr is also reached through WireGuard on Windows.
SONARR_URL=
SONARR_API_KEY=
HTTP_ADDR=127.0.0.1:8080
# Optional for local production serving; Docker sets this automatically.
# STATIC_DIR=../client/dist

# Enable after configuring ntfy. First successful poll is a silent baseline.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_INTERVAL=15s
NOTIFICATION_DB=data/reqarr.db
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=reqarr
# Use a token OR username/password, never both.
NTFY_TOKEN=
NTFY_USERNAME=
NTFY_PASSWORD=
